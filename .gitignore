# Dependencies
node_modules/
.npm/

# Build output
dist/
build/
client/dist/
server/dist/
shared/dist/
*.tsbuildinfo

# Environment and secrets (never commit these)
.env
.env.*
!.env.example

# Database (SQLite files are generated by the seed script)
server/data/*
data/*
!server/data/.gitkeep
!data/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Test output
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Vite / PWA dev artifacts
client/dev-dist/
.vite/
*.local

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Misc
tmp/
.cache/
.eslintcache
