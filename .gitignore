!data/.gitkeep
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test output
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/
.vitest/

# Vite / PWA
client/dev-dist/
.vite/
*.local
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

